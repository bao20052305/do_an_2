# Chép file này thành .env rồi điền giá trị thật vào.
# Cần: pip install python-dotenv

# ---- API nguồn dữ liệu
AISSTREAM_API_KEY=
GFW_API_ACCESS_TOKEN=

# ---- Iceberg: địa chỉ cho script chạy trên máy (trong Docker thì dùng iceberg-rest, minio)
ICEBERG_REST_URI=http://localhost:8181
S3_ENDPOINT=http://localhost:9000

# ---- MinIO (cũng là khóa S3 cho Iceberg, Spark, Flink, Trino)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=doi_mat_khau_nay
MINIO_BUCKET=warehouse
AWS_REGION=us-east-1

# ---- PostgreSQL cho Iceberg REST catalog
CATALOG_DB_USER=iceberg
CATALOG_DB_PASSWORD=doi_mat_khau_nay
CATALOG_DB_NAME=iceberg_catalog

# ---- Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=doi_mat_khau_nay
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=doi_mat_khau_nay
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Chuỗi ngẫu nhiên bất kỳ
AIRFLOW_SECRET_KEY=
